+/* The simple 8-bit IDCT uses these fixed-point sums in its C and x86 paths.
+ * Compute them wide before any 16-bit row store or 32-bit column arithmetic.
+ * This only decides whether the existing transform can run; it changes no pixel.
+ */
+static void mpeg12_idct_sums(const int64_t *v, int64_t bias, int64_t *out)
+{
+    int64_t a0 = 16383 * v[0] + bias;
+    int64_t a1 = a0, a2 = a0, a3 = a0;
+    int64_t b0, b1, b2, b3;
+
+    a0 += 21407 * v[2] + 16383 * v[4] + 8867 * v[6];
+    a1 +=  8867 * v[2] - 16383 * v[4] - 21407 * v[6];
+    a2 += -8867 * v[2] - 16383 * v[4] + 21407 * v[6];
+    a3 += -21407 * v[2] + 16383 * v[4] - 8867 * v[6];
+    b0 = 22725 * v[1] + 19266 * v[3] + 12873 * v[5] + 4520 * v[7];
+    b1 = 19266 * v[1] - 4520 * v[3] - 22725 * v[5] - 12873 * v[7];
+    b2 = 12873 * v[1] - 22725 * v[3] + 4520 * v[5] + 19266 * v[7];
+    b3 = 4520 * v[1] - 12873 * v[3] + 19266 * v[5] - 22725 * v[7];
+    out[0] = a0 + b0;
+    out[7] = a0 - b0;
+    out[1] = a1 + b1;
+    out[6] = a1 - b1;
+    out[2] = a2 + b2;
+    out[5] = a2 - b2;
+    out[3] = a3 + b3;
+    out[4] = a3 - b3;
+}
+
+static int mpeg12_check_idct(const int16_t *block, const uint8_t *permutation)
+{
+    int64_t rows[64], v[8], sums[8];
+    unsigned magnitude = 0;
+    int x, y;
+
+    for (x = 0; x < 64; x++)
+        magnitude += FFABS(block[x]);
+    /* With total magnitude <= 2047, the largest row factor (22725),
+     * its 11-bit shift and rounding bound every row below 22725. Applying
+     * the column factors to their sum stays below 2^30, including rounding.
+     * Larger blocks get the exact checks below, not a magnitude rejection.
+     */
+    if (magnitude <= 2047)
+        return 0;
+    for (y = 0; y < 8; y++) {
+        int ac = 0;
+        for (x = 0; x < 8; x++) {
+            v[x] = block[permutation[y * 8 + x]];
+            if (x)
+                ac |= v[x] != 0;
+        }
+        mpeg12_idct_sums(v, 1024, sums);
+        for (x = 0; x < 8; x++) {
+            /* Keep the existing DC-only shortcut, including its rounding. */
+            int64_t value = ac ? sums[x] >> 11 : v[0] * 8;
+            if (value < INT16_MIN || value > INT16_MAX)
+                return AVERROR_PATCHWELCOME;
+            rows[y * 8 + x] = value;
+        }
+    }
+    for (x = 0; x < 8; x++) {
+        for (y = 0; y < 8; y++)
+            v[y] = rows[y * 8 + x];
+        /* x86 adds the rounding offset as a signed 16-bit value first. */
+        if (v[0] > INT16_MAX - 32)
+            return AVERROR_PATCHWELCOME;
+        mpeg12_idct_sums(v, 16383 * 32, sums);
+        for (y = 0; y < 8; y++)
+            if (sums[y] < INT32_MIN || sums[y] > INT32_MAX)
+                return AVERROR_PATCHWELCOME;
+    }
     return 0;
 }

