# Every pinned input of the build. The shell scripts source this file, so a
# version changes in one place. A version bump fails the build until the
# matching *_SHA256 line is updated. AGENTS.md describes how.

# Sources. FFmpeg must stay on a release line that the pinned ffmpeg-next
# crate in smoke-test/Cargo.toml supports.
FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
DAV1D_VERSION=1.5.4
DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5
ZLIB_VERSION=1.4
ZLIB_SHA256=4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c

# Build containers for the Linux targets, pinned by digest. AlmaLinux 8 sets
# the glibc baseline (docs/adr/0003-glibc-2-28-baseline.md), and the build
# stops if the image has another glibc than GLIBC_VERSION.
GLIBC_VERSION=2.28
GLIBC_IMAGE_TAG=8.10-20261027
GLIBC_IMAGE_DIGEST=sha256:2d0f2eb2a83cc09dbc2eb92fade4dbe8f709628149e81aa00aec70630406603b
MUSL_IMAGE_TAG=3.24.4
MUSL_IMAGE_DIGEST=sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# The oldest macOS the Apple builds run on (docs/adr/0002-targets.md).
MACOS_DEPLOYMENT_TARGET=11.0
