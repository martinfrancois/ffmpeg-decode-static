{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "pinDigests": true,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "dependencyDashboardApproval": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "automergeType": "pr",
  "ignoreTests": false,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [],
    "updateNotScheduled": true,
    "groupName": null,
    "groupSlug": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Source versions in versions.env, described by the \"# renovate:\" comment above each one.",
      "managerFilePatterns": [
        "/^versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n[A-Z0-9]+_VERSION=(?<currentValue>\\S+)\\n"
      ]
    },
    {
      "customType": "regex",
      "description": "Container images in versions.env: a tag line followed by its digest line.",
      "managerFilePatterns": [
        "/^versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n[A-Z]+_IMAGE_TAG=(?<currentValue>\\S+)\\n[A-Z]+_IMAGE_DIGEST=(?<currentDigest>sha256:[a-f0-9]+)\\n"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Public repository: merge eligible non-major updates after checks pass. Group only dependencies that need coordinated updates; keep unrelated updates separate.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates require human review of migration notes. Preserve compatibility groups whose members must move together across a major boundary.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major update"
      ]
    },
    {
      "description": "A new source version changes what the libraries contain, and its checksum has to come from a person who compared it with upstream (AGENTS.md). CI fails on these pull requests until then.",
      "matchDepNames": [
        "FFmpeg/FFmpeg",
        "videolan/dav1d",
        "madler/zlib"
      ],
      "automerge": false
    },
    {
      "description": "The crate follows FFmpeg's versions, so a person updates it in the same pull request as FFMPEG_VERSION in versions.env.",
      "matchDepNames": [
        "ffmpeg-next"
      ],
      "automerge": false
    },
    {
      "description": "AlmaLinux 8 sets the glibc baseline. AlmaLinux 9 has a newer glibc than the libraries promise (docs/adr/0003-glibc-2-28-baseline.md).",
      "matchDepNames": [
        "docker.io/library/almalinux"
      ],
      "allowedVersions": "/^8\\./"
    }
  ]
}
